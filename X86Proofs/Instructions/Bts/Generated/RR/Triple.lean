    ⟨rex, modrm, hbytes, hrex, hmod, hdst, hsrc⟩
  · rw [hbytes, ← hdst, ← hsrc]
    exact bts_r16_r16_triple_of_bytes p modrm hmod
  · rw [hbytes, ← hdst, ← hsrc]
    exact bts_r16_r16_rex_triple_of_bytes p rex hrex modrm hmod

attribute [x86_compose] btsR64R64Effect btsR32R32Effect btsR16R16Effect

@[x86_local] theorem btsR64R64Effect_local {p : BitVec 64} {len : Nat}
    {dst src : BitVec 5} :
    Effect.Local (btsR64R64Effect p len dst src) := by
  effect_local [btsR64R64Effect, btFlags]

