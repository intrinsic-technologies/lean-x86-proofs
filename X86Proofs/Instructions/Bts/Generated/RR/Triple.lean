theorem bts_r64_r64_triple [Bindings] (p : BitVec 64) (dst src : BitVec 4) :
    Triple (fun s => s.RIP = p) (codeRange p (encodeBtsR64R64 dst src))
      (Effect.post (btsR64R64Effect p (encodeBtsR64R64 dst src).length (dst.setWidth 5)
        (src.setWidth 5))) := by
  obtain ⟨rex, modrm, hbytes, hrex, hmod, hdst, hsrc⟩ := encodeBtsR64R64_spec dst src
  rw [hbytes, ← hdst, ← hsrc]
  exact bts_r64_r64_triple_of_bytes p rex hrex modrm hmod

theorem bts_r32_r32_triple [Bindings] (p : BitVec 64) (dst src : BitVec 4) :
    Triple (fun s => s.RIP = p) (codeRange p (encodeBtsR32R32 dst src))
      (Effect.post (btsR32R32Effect p (encodeBtsR32R32 dst src).length (dst.setWidth 5)
        (src.setWidth 5))) := by
  rcases encodeBtsR32R32_spec dst src with ⟨modrm, hbytes, hmod, hdst, hsrc⟩ |
    ⟨rex, modrm, hbytes, hrex, hmod, hdst, hsrc⟩
  · rw [hbytes, ← hdst, ← hsrc]
    exact bts_r32_r32_triple_of_bytes p modrm hmod
  · rw [hbytes, ← hdst, ← hsrc]
    exact bts_r32_r32_rex_triple_of_bytes p rex hrex modrm hmod

