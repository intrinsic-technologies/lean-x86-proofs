    rwa [show am.tail.length + 1 + 1 + 1 + 1 = 4 + am.tail.length by omega]

attribute [x86_compose] subR64M64Effect subR32M32Effect subR16M16Effect

@[x86_local] theorem subR64M64Effect_local {p : BitVec 64} {dst : BitVec 5} {am : AddrMode} :
    Effect.Local (subR64M64Effect p dst am) := by
  effect_local [subR64M64Effect]

