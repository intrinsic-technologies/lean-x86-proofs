    (am : AddrMode) (s : RamState) :
    (subR32M32A32Effect p len dst am s).components = [.reg dst, .flags, .rip] := rfl

def subR16M16A32Effect (p : BitVec 64) (len : Nat) (dst : BitVec 5) (am : AddrMode)
    (s : RamState) : Effect :=
