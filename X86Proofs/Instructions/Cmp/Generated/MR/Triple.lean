      (codeRange p (encodeCmpM32R32 src am))
      (Effect.post (cmpMREffect p (encodeCmpM32R32 src am).length 32 (src.setWidth 5) am)) := by
  unfold encodeCmpM32R32
  split
  · rename_i hc
    obtain ⟨hr, hx, hb⟩ := hc
    have := cmp_m32_r32_triple_of_bytes p (regLow src) am hv hx hb
    rw [show gprNumber 0 0 (regLow src) = src.setWidth 5 by rw [← gprNumber_reg src, hr]] at this
    simp only [List.length_cons]
    rwa [show am.tail.length + 1 + 1 = 2 + am.tail.length by omega]
  · obtain ⟨hrex, hr, hx, hb⟩ := am.rexByte_false_spec src
    have := cmp_m32_r32_rex_triple_of_bytes p _ hrex (regLow src) am hv hx hb
