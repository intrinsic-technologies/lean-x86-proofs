theorem movsx_r64_r16_triple [Bindings] (p : BitVec 64) (dst src : BitVec 4) :
    Triple (fun s => s.RIP = p) (codeRange p (encodeMovsxR64R16 dst src))
      (Effect.post (movsxR64R16Effect p (encodeMovsxR64R16 dst src).length (dst.setWidth 5)
        (src.setWidth 5))) := by
  obtain ⟨rex, modrm, hbytes, hrex, hmod, hdst, hsrc⟩ := encodeMovsxR64R16_spec dst src
  rw [hbytes, ← hdst, ← hsrc]
  exact movsx_r64_r16_triple_of_bytes p rex hrex modrm hmod

theorem movsx_r32_r16_triple [Bindings] (p : BitVec 64) (dst src : BitVec 4) :
    Triple (fun s => s.RIP = p) (codeRange p (encodeMovsxR32R16 dst src))
      (Effect.post (movsxR32R16Effect p (encodeMovsxR32R16 dst src).length (dst.setWidth 5)
        (src.setWidth 5))) := by
  rcases encodeMovsxR32R16_spec dst src with ⟨modrm, hbytes, hmod, hdst, hsrc⟩ |
    ⟨rex, modrm, hbytes, hrex, hmod, hdst, hsrc⟩
  · rw [hbytes, ← hdst, ← hsrc]
    exact movsx_r32_r16_triple_of_bytes p modrm hmod
  · rw [hbytes, ← hdst, ← hsrc]
    exact movsx_r32_r16_rex_triple_of_bytes p rex hrex modrm hmod

