  · rw [hbytes, ← hdst, ← hsrc]
    exact movsx_r16_r16_triple_of_bytes p modrm hmod
  · rw [hbytes, ← hdst, ← hsrc]
    exact movsx_r16_r16_rex_triple_of_bytes p rex hrex modrm hmod

attribute [x86_compose] movsxR64R16Effect movsxR32R16Effect movsxR16R16Effect

