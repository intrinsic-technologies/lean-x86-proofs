  · have hl : (r.prefixByte :: 0xF2 :: 0x0F :: 0x5E :: am.modrm (regLow dst) ::
        am.tail : List UInt8).length = 5 + am.tail.length := by simp; omega
    rw [hbytes, ← hreg, hl]
    exact divsd_xmm_m64_seg_triple_of_bytes p r base (regLow dst) am hv hx hb
  · obtain ⟨hrex, hr, hx, hb⟩ := am.rexByte_false_spec dst
    have := divsd_xmm_m64_rex_seg_triple_of_bytes p r base _
