@[simp] theorem divsdXmmM64SegEffect_components (p : BitVec 64) (len : Nat) (base : BitVec 64)
    (dst : BitVec 5) (am : AddrMode) (s : RamState) :
    (divsdXmmM64SegEffect p len base dst am s).components = [.xmm dst, .mxcsr, .rip] := rfl

