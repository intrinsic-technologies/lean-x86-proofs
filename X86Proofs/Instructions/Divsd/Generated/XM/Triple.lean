        (divsdXmmM64SegOk p (r.prefixByte :: encodeDivsdXmmM64 dst am).length base (dst.setWidth 5) am))
      (codeRange p (r.prefixByte :: encodeDivsdXmmM64 dst am))
      (Effect.post (divsdXmmM64SegEffect p (r.prefixByte :: encodeDivsdXmmM64 dst am).length base
        (dst.setWidth 5) am)) := by
