      (FpPre (Sse2LoadNPre p
        (fun s => am.addr s (p + BitVec.ofNat 64 (4 + am.tail.length))) 8)
        (divsdXmmM64Ok p (4 + am.tail.length) (gprNumber 0 0 reg) am))
      (codeRange p (0xF2 :: 0x0F :: 0x5E :: am.modrm reg :: am.tail))
      (Effect.post (divsdXmmM64Effect p (4 + am.tail.length)
