    ⟨rex, modrm, hbytes, hrex, hmod, hdst, hsrc⟩
  · rw [hbytes, ← hdst, ← hsrc]
    exact imul_r16_r16_triple_of_bytes p modrm hmod
  · rw [hbytes, ← hdst, ← hsrc]
    exact imul_r16_r16_rex_triple_of_bytes p rex hrex modrm hmod

attribute [x86_compose] imulR64R64Effect imulR32R32Effect imulR16R16Effect

@[x86_local] theorem imulR64R64Effect_local {p : BitVec 64} {len : Nat} {dst : BitVec 5}
    {src : BitVec 5} :
    Effect.Local (imulR64R64Effect p len dst src) := by
  effect_local [imulR64R64Effect, imulFlags]

