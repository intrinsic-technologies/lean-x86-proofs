
import X86Proofs.Step.AfterStep
import X86Proofs.Program.ReadWrite.RepString
import X86Proofs.Instructions.Stos.Generated.Rep.Decode
import X86Proofs.Instructions.Stos.Generated.Rep.Form

namespace X86Proofs

open X86 X86.Machine X86.UserProcess X86.Helpers

def repStosAfter (n len : Nat) (s : RamState) : RamState :=
  afterStep s len fun t =>
    repCount (stosSpec n { t with Next_IP := BitVec.add s.RIP (BitVec.ofNat 64 len) })

theorem repStosAfter_external (n len : Nat) (s : RamState) :
    (repStosAfter n len s).external =
      memStore s.external (rdi.read s) ((Operand.reg 0 : Operand n).read s) := rfl

@[simp] theorem repStosAfter_rflags (n len : Nat) (s : RamState) :
    (repStosAfter n len s).RFLAGS = s.RFLAGS := rfl

theorem repStosAfter_gpr (n len : Nat) (s : RamState) :
    (repStosAfter n len s).GPR =
      Vector.set (Vector.set s.GPR 7 (s.GPR[7] + BitVec.ofNat _ (n / 8))) 1 (s.GPR[1] - 1) := by
  simp [repStosAfter, repCount, afterStep, finishStep, stosSpec, Operand.write, Operand.read,
    dataAccess, afterFetches, beforeFetch, resetStepFields, gprIndex, mergeGPR_64, Vector.getElem_set]
  rfl

theorem repStosAfter_rdi (n len : Nat) (s : RamState) :
    rdi.read (repStosAfter n len s) = rdi.read s + BitVec.ofNat 64 (n / 8) := by
  simp [Operand.read, repStosAfter_gpr, gprIndex, Vector.getElem_set]
  rfl

theorem repStosAfter_rcx (n len : Nat) (s : RamState) :
    rcx.read (repStosAfter n len s) = rcx.read s - 1 := by
  simp [Operand.read, repStosAfter_gpr, gprIndex]

theorem repStosAfter_rax (n len : Nat) (s : RamState) :
    (Operand.reg 0 : Operand n).read (repStosAfter n len s) = (Operand.reg 0 : Operand n).read s := by
  simp [Operand.read, repStosAfter_gpr, gprIndex]

theorem rcx_read_stosSpec (n : Nat) (t : RamState) : rcx.read (stosSpec n t) = rcx.read t := by
  simp only [stosSpec]
  rw [Operand.read_write_reg_of_ne _ (by decide), Operand.read_reg_write_mem,
    Operand.read_reg_dataAccess]

theorem repStosAfter_repeat (n len : Nat) (s : RamState) :
    (repStosAfter n len s).Repeat_String_Operation = !(rcx.read s - 1 == 0#64) := by
  simp only [repStosAfter, afterStep, finishStep, repCount, rcx_read_stosSpec]
  rfl

theorem repStosAfter_rip (n len : Nat) (s : RamState) (hmsr : s.«MSRLIST::In_Process» = false) :
    (repStosAfter n len s).RIP =
      if rcx.read s - 1 = 0 then BitVec.add s.RIP (BitVec.ofNat 64 len) else s.RIP := by
  simp only [repStosAfter, afterStep, finishStep, repCount, rcx_read_stosSpec]
  simp [stosSpec, Operand.write, dataAccess, afterFetches, beforeFetch, resetStepFields, hmsr]

theorem AgreesExcept.repStos (n len : Nat) (s : RamState) :
    AgreesExcept [.reg 1, .reg 7, .mem (rdi.read s) (n / 8), .rip] (clearRep s)
      (clearRep (repStosAfter n len s)) := by
  refine ⟨fun c hc hm => ?_, fun x hx => ?_, ?_, fun x hx => ?_⟩
  · cases c with
    | reg r =>
      have h1' : r ≠ 1 := fun h => hc (by simp [h])
      have h1 : r.toNat ≠ 1 := fun e => h1' (BitVec.eq_of_toNat_eq e)
      have h7' : r ≠ 7 := fun h => hc (by simp [h])
      have h7 : r.toNat ≠ 7 := fun e => h7' (BitVec.eq_of_toNat_eq e)
      simp [Component.Agrees, clearRep, repStosAfter_gpr, gprIndex, Ne.symm h1, Ne.symm h7]
    | flags => rfl
    | rip => exact absurd (by simp) hc
    | mem a len => exact absurd hm (by simp [Component.isMem])
    | xmm x => exact Component.agrees_xmm_of_zmm rfl x
    | mxcsr => rfl
    | fpr x => exact Component.agrees_fpr_of_fp87 rfl x
    | fsw => rfl
    | fcc => rfl
    | ftw => rfl
    | fcw => rfl
    | fpuPtr => rfl
    | df => rfl
  · simp only [clearRep_external]
    rw [repStosAfter_external]
    apply memStore_getElem?_of_ne
    intro i hi he
    exact hx (.mem (rdi.read s) (n / 8)) (by simp) ⟨i, hi, he.symm⟩
  · simp only [fixedPart, clearRep, repStosAfter, repCount, afterStep, finishStep, stosSpec,
      Operand.write, dataAccess, afterFetches, beforeFetch, resetStepFields]
  · simp only [clearRep_external] at hx ⊢
    rw [repStosAfter_external]
    exact memStore_isSome _ _ _ x hx

theorem ReadyMidRep.repStos [Bindings] {s : RamState} (h : ReadyMidRep s) (n len : Nat)
    (hdst : (rdi.read s).toNat + n / 8 ≤ 2^32)
    (htables : PageTableEntriesApart (rdi.read s).toNat (n / 8)) :
    ReadyMidRep (repStosAfter n len s) := by
  have htab : IdentityPageTableMemory (clearRep (repStosAfter n len s)).external := by
    rw [clearRep_external, repStosAfter_external]
    exact IdentityPageTableMemory.memStore (ReadyToStep.memory (s := clearRep s) h).tables _ _
      hdst htables
  have : ReadyToStep (clearRep (repStosAfter n len s)) :=
    ReadyToStep.of_agreesExcept h.clear (AgreesExcept.repStos n len s) htab
  exact this

theorem repStosAfter_fill (n len : Nat) (s : RamState) (hn : n ≤ 128) (i : Nat) (hi : i < n / 8) :
    (repStosAfter n len s).external[rdi.read s + BitVec.ofNat 64 i]? =
      some (storedByte ((Operand.reg 0 : Operand n).read s) i) := by
  rw [repStosAfter_external, memStore_getElem?_self _ _ _ hn i hi]

theorem rep_stosq_step [inst : Bindings] (hstride : Prelude.UnitStringStride inst) (s : RamState)
    (h : ReadyMidRep s) (pre : List UInt8) (hpre : ∀ p ∈ pre, ScanPrefix p)
    (hlen : pre.length ≤ 13)
    (haddr : (scanContext s.DS (PrefixSegments.ofState s) pre).address_size = 64)
    (hrex2 : (scanContext s.DS (PrefixSegments.ofState s) pre).rex2_prefix_present = false)
    (hw : (scanContext s.DS (PrefixSegments.ofState s) pre).rex_w = 1)
    (hrep : (scanContext s.DS (PrefixSegments.ofState s) pre).rep_prefix = 243)
    (hlock : (scanContext s.DS (PrefixSegments.ofState s) pre).lock_prefix_present = false)
    (hdf : DirectionFlagClear s.RFLAGS) (hcode : BytesAt s s.RIP (pre ++ [0xAB]))
    (hlow : s.RIP.toNat + (pre.length + 1) ≤ 2^32) (hcount : rcx.read s ≠ 0)
    (hwr : MemWritable s (rdi.read s) 8) :
    X86.Machine.step s = some (.next (repStosAfter 64 (pre.length + 1) s)) := by
  have hlen' : (pre ++ [0xAB]).length = pre.length + 1 := by simp
  have hlow' : s.RIP.toNat + (pre ++ [0xAB]).length ≤ 2^32 := by
    rw [hlen']; exact hlow
  have hf := h.fetchReady
  have hmode (k : Nat) : In64BitMode (afterFetches (beforeFetch s) k) :=
    in64BitMode_of_userCodeSegment hf.cs hf.efer.lma
  have hdecode := decodeLegacy0_run_of_AB_rep_stosq s h _ hrex2 hw hrep _
    pre.length (by omega) (by simp) hcode hlow'
  have ht : DataReady (afterFetches (beforeFetch s) (pre.length + 2)) :=
    h.dataReady.of_sameControls ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩
      rfl rfl rfl rfl rfl hf.tables
  have hcpu := ReadyToStep.cpu (s := clearRep s) h
  rw [rep_stosq_form hstride (afterFetches (beforeFetch s) (pre.length + 2)) _ _ ht (hmode _) haddr hrex2 hlock hw hcpu.es
    hdf hcount (hwr.of_external_eq rfl)] at hdecode
  have hpreserve : scanPreservesRepeat (0xAB : UInt8).toBitVec (scanContext s.DS (PrefixSegments.ofState s) pre) = true := by
    simp [scanPreservesRepeat, hrep]
  have hstep := step_scan_legacy0_midRep s _ h pre 0xAB [] hpre
    (legacyOpcode_of_check _ ⟨by decide, by decide⟩) (by omega) hcode hlow' hdecode
    ((hmode (pre.length + 2)).of_cs_lma_eq rfl rfl)
  rw [hpreserve] at hstep
  exact hstep

