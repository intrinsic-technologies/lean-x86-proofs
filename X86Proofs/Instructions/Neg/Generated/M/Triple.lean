def negMEffect (p : BitVec 64) (len n : Nat) (am : AddrMode) (s : RamState) : Effect :=
  let addr := am.addr s (p + BitVec.ofNat 64 len)
  let a := (Operand.mem addr : Operand n).read s
  { rip := p + BitVec.ofNat 64 len
    writes := [⟨(Operand.mem addr : Operand n), -a⟩]
    flags := some (.ofStatusFlags (negSpec a).2) }

@[simp] theorem negMEffect_components (p : BitVec 64) (len n : Nat) (am : AddrMode) (s : RamState) :
    (negMEffect p len n am s).components =
      [.mem (am.addr s (p + BitVec.ofNat 64 len)) (n / 8), .flags, .rip] := rfl

def negMSegEffect (p : BitVec 64) (len n : Nat) (base : BitVec 64) (am : AddrMode) (s : RamState) :
    Effect :=
  let addr := base + am.addr s (p + BitVec.ofNat 64 len)
  let a := (Operand.mem addr : Operand n).read s
  { rip := p + BitVec.ofNat 64 len
    writes := [⟨(Operand.mem addr : Operand n), -a⟩]
    flags := some (.ofStatusFlags (negSpec a).2) }

@[simp] theorem negMSegEffect_components (p : BitVec 64) (len n : Nat) (base : BitVec 64)
    (am : AddrMode) (s : RamState) : (negMSegEffect p len n base am s).components =
      [.mem (base + am.addr s (p + BitVec.ofNat 64 len)) (n / 8), .flags, .rip] :=
  rfl

