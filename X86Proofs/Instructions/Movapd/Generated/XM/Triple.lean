theorem movapd_xmm_m128_triple [Bindings] (p : BitVec 64) (dst : BitVec 4) (am : AddrMode)
    (hv : am.Valid) :
    Triple
      (Sse2AlignedLoadPre p
        (fun s => am.addr s (p + BitVec.ofNat 64 (encodeMovapdXmmM128 dst am).length)))
      (codeRange p (encodeMovapdXmmM128 dst am))
      (Effect.post (movapdXmmM128Effect p (encodeMovapdXmmM128 dst am).length
        (dst.setWidth 5) am)) := by
  unfold encodeMovapdXmmM128
  rcases encodeSseMem_spec 0x28 dst am with ⟨hbytes, hx, hb, hreg⟩ | hbytes
  · have hl : (0x66 :: 0x0F :: 0x28 :: am.modrm (regLow dst) :: am.tail :
        List UInt8).length = 4 + am.tail.length := by simp; omega
    rw [hbytes, ← hreg, hl]
