theorem movd_m32_xmm_triple [Bindings] (p : BitVec 64) (src : BitVec 4) (am : AddrMode)
    (hv : am.Valid) :
    Triple
      (Sse2StoreNPre p (encodeMovdM32Xmm src am).length
        (fun s => am.addr s (p + BitVec.ofNat 64 (encodeMovdM32Xmm src am).length)) 4)
      (codeRange p (encodeMovdM32Xmm src am))
      (Effect.post (movdM32XmmEffect p (encodeMovdM32Xmm src am).length
        (src.setWidth 5) am)) := by
  unfold encodeMovdM32Xmm
  rcases encodeSseMem_spec 0x7E src am with ⟨hbytes, hx, hb, hreg⟩ | hbytes
  · have hl : (0x66 :: 0x0F :: 0x7E :: am.modrm (regLow src) :: am.tail :
        List UInt8).length = 4 + am.tail.length := by simp; omega
    rw [hbytes, ← hreg, hl]
    exact movd_m32_xmm_triple_of_bytes p (regLow src) am hv hx hb
  · obtain ⟨hrex, hr, hx, hb⟩ := am.rexByte_false_spec src
    have := movd_m32_xmm_rex_triple_of_bytes p _ hrex (regLow src) am hv hx hb
    rw [hr, gprNumber_reg] at this
    have hl : (0x66 :: am.rexByte false src :: 0x0F :: 0x7E :: am.modrm (regLow src) ::
        am.tail).length = 5 + am.tail.length := by simp; omega
    rw [hbytes, hl]
    exact this

theorem movd_m32_xmm_seg_triple [Bindings] (p : BitVec 64) (r : SegReg) (base : BitVec 64)
    (src : BitVec 4) (am : AddrMode) (hv : am.Valid) :
    Triple
      (fun s => Sse2StoreNPre p (r.prefixByte :: encodeMovdM32Xmm src am).length
        (fun t => base + am.addr t (p + BitVec.ofNat 64 (r.prefixByte :: encodeMovdM32Xmm src am).length)) 4 s ∧ r.Ready base s)
      (codeRange p (r.prefixByte :: encodeMovdM32Xmm src am))
      (Effect.post (movdM32XmmSegEffect p (r.prefixByte :: encodeMovdM32Xmm src am).length base
        (src.setWidth 5) am)) := by
  unfold encodeMovdM32Xmm
  rcases encodeSseMem_spec 0x7E src am with ⟨hbytes, hx, hb, hreg⟩ | hbytes
  · have hl : (r.prefixByte :: 0x66 :: 0x0F :: 0x7E :: am.modrm (regLow src) ::
        am.tail : List UInt8).length = 5 + am.tail.length := by simp; omega
    rw [hbytes, ← hreg, hl]
