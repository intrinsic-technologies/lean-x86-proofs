theorem mulss_xmm_m32_triple [Bindings] (p : BitVec 64) (dst : BitVec 4) (am : AddrMode)
    (hv : am.Valid) :
    Triple
      (FpPre (SseLoadNPre p
        (fun s => am.addr s (p + BitVec.ofNat 64 (encodeMulssXmmM32 dst am).length)) 4)
        (mulssXmmM32Ok p (encodeMulssXmmM32 dst am).length (dst.setWidth 5) am))
      (codeRange p (encodeMulssXmmM32 dst am))
      (Effect.post (mulssXmmM32Effect p (encodeMulssXmmM32 dst am).length
        (dst.setWidth 5) am)) := by
  unfold encodeMulssXmmM32
  rcases encodeSseMem_spec 0x59 dst am with ⟨hbytes, hx, hb, hreg⟩ | hbytes
  · have hl : (0xF3 :: 0x0F :: 0x59 :: am.modrm (regLow dst) :: am.tail :
        List UInt8).length = 4 + am.tail.length := by simp; omega
    rw [hbytes, ← hreg, hl]
    exact mulss_xmm_m32_triple_of_bytes p (regLow dst) am hv hx hb
  · obtain ⟨hrex, hr, hx, hb⟩ := am.rexByte_false_spec dst
    have := mulss_xmm_m32_rex_triple_of_bytes p _ hrex.rexPrefix (regLow dst) am hv hx hb
    rw [hr, gprNumber_reg] at this
    have hl : (0xF3 :: am.rexByte false dst :: 0x0F :: 0x59 :: am.modrm (regLow dst) ::
        am.tail).length = 5 + am.tail.length := by simp; omega
    rw [hbytes, hl]
    exact this

