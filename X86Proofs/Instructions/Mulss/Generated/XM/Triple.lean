      (codeRange p (0x67 :: 0xF3 :: rex :: 0x0F :: 0x59 :: am.modrm reg :: am.tail))
      (Effect.post (mulssXmmM32A32Effect p (6 + am.tail.length)
        (gprNumber 0 (rexR rex.toBitVec) reg) am)) :=
