    (p : BitVec 64) (reg : BitVec 3) (am : AddrMode)
    (hv : am.Valid) (hx : am.rexX = 0) (hb : am.rexB = 0) :
    Triple
      (FpPre (SseLoadNPre p
        (fun s => am.addr s (p + BitVec.ofNat 64 (4 + am.tail.length))) 4)
        (mulssXmmM32Ok p (4 + am.tail.length) (gprNumber 0 0 reg) am))
      (codeRange p (0xF3 :: 0x0F :: 0x59 :: am.modrm reg :: am.tail))
      (Effect.post (mulssXmmM32Effect p (4 + am.tail.length)
