theorem mov_r64_r64_rev_triple [Bindings] (p : BitVec 64) (dst src : BitVec 4) :
    Triple (fun s => s.RIP = p) (codeRange p (encodeMovR64R64Rev dst src))
      (Effect.post (movR64R64Effect p (dst.setWidth 5)
        (src.setWidth 5))) := by
  obtain ⟨rex, modrm, hbytes, hrex, hmod, hdst, hsrc⟩ := encodeMovR64R64Rev_spec dst src
  rw [hbytes, ← hdst, ← hsrc]
  exact mov_r64_r64_rev_triple_of_bytes p rex hrex modrm hmod

theorem mov_r32_r32_rev_triple [Bindings] (p : BitVec 64) (dst src : BitVec 4) :
    Triple (fun s => s.RIP = p) (codeRange p (encodeMovR32R32Rev dst src))
      (Effect.post (movR32R32Effect p (encodeMovR32R32Rev dst src).length (dst.setWidth 5)
        (src.setWidth 5))) := by
  rcases encodeMovR32R32Rev_spec dst src with ⟨modrm, hbytes, hmod, hdst, hsrc⟩ |
    ⟨rex, modrm, hbytes, hrex, hmod, hdst, hsrc⟩
  · rw [hbytes, ← hdst, ← hsrc]
    exact mov_r32_r32_rev_triple_of_bytes p modrm hmod
  · rw [hbytes, ← hdst, ← hsrc]
    exact mov_r32_r32_rev_rex_triple_of_bytes p rex hrex modrm hmod

